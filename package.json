{
  "name": "mpk-traffic-disruptions",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "clean:node_modules": "rm -rf node_modules",
    "clean:coverage": "rm -rf coverage",
    "clean:all": "rm -rf dist node_modules coverage",
    "start": "node dist/cli/index.js",
    "start-server": "node dist/index.js",
    "dev": "tsx watch src/cli/index.ts",
    "dev-server": "tsx watch src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "site": "npm run test:coverage ; open coverage/index.html",
    
    "prod": "npm run build && npm start",
    "prod-server": "npm run build && npm run start-server"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/express": "^5.0.3",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^24.7.0",
    "@types/node-cron": "^3.0.11",
    "domhandler": "5.0.3",
    "jest": "^29.7.0",
    "tsx": "^4.20.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "discord.js": "^14.23.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "iconv-lite": "^0.7.0",
    "node-cron": "^4.2.1",
    "ts-jest": "^29.4.6",
    "zod": "^4.1.12"
  },
  "packageManager": "npm@11.7.0"
}
